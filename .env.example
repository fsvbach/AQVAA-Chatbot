# ── Docker ────────────────────────────────────────────────────────────────────
CHATBOT_PORT=8090
# Directory with the chatbot's knowledge (see README.md, "Data directory"),
# mounted read-only at /app/data. Relative paths start at this repo.
CHATBOT_DATA_DIR=./data

MILVUS_VERSION=v2.6.0
ETCD_VERSION=v3.5.18
MINIO_VERSION=RELEASE.2024-12-18T13-15-44Z
MILVUS_PORT=19530

# ── AQVAA platform (source of questions, candidates and their reactions) ──────
# Host-mode URL; docker compose overrides it with http://backend:3000
LLM_PLATFORM_URL=http://localhost:3000
# ID of the reaction batch to index. Unset = no candidate data in the index.
# LLM_REACTION_BATCH_ID=1
# Must equal LLM_SERVICE_TOKEN in the platform's .env
LLM_SERVICE_TOKEN=CHANGE_ME

# ── LLM ───────────────────────────────────────────────────────────────────────
# Options: "ollama" | "vLLM" | "openAI"
LLM_LLM_PROVIDER="vLLM"
LLM_LLM_BASE_URL=http://localhost:8000/v1
LLM_EMBEDDING_BASE_URL=http://localhost:8001/v1
# LLM_OPEN_AI_API_KEY=

LLM_LLM_MODEL="Qwen/Qwen3.6-35B-A3B-FP8"
LLM_EMBEDDING_MODEL="Qwen/Qwen3-Embedding-8B"

# Auxiliary (small, fast) model for the guardrails and the query router
# (_AUX_ROLES in config.py). Unset = the main model serves these roles too.
# The module benchmarks ran them on google/gemma-4-E4B-it.
# LLM_AUX_PROVIDER="vLLM"
# LLM_AUX_BASE_URL=http://localhost:8002/v1
# LLM_AUX_MODEL="google/gemma-4-E4B-it"

# adjust for each mode model individually!
LLM_SAMPLING_TEMPERATURE=1.0
LLM_SAMPLING_TOP_P=0.95
LLM_SAMPLING_TOP_K=64

# ── Vector store ──────────────────────────────────────────────────────────────
# Default is a Milvus Lite file under data/milvus/; docker compose overrides it
# with http://milvus-standalone:19530
# LLM_MILVUS_URI=http://localhost:19530
# Rebuild all collections on startup (e.g. after switching LLM_REACTION_BATCH_ID)
# LLM_FORCE_REINDEX=true

# ── RAG Tracing ───────────────────────────────────────────────────────────────
LLM_TRACING_ENABLED=true
# Host-mode URL; docker compose overrides it with http://phoenix:6006/v1/traces
LLM_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
